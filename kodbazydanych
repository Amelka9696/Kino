-- ============================================
-- PROSTY SYSTEM KINA ONLINE
-- SQL SERVER MANAGEMENT STUDIO
-- ============================================

CREATE DATABASE Kino;
GO

USE Kino;
GO

-- ============================================
-- TABELA UZYTKOWNICY
-- ============================================

CREATE TABLE Users (
    UserID INT PRIMARY KEY IDENTITY(1,1),
    FirstName VARCHAR(50) NOT NULL,
    LastName VARCHAR(50) NOT NULL,
    Email VARCHAR(100) UNIQUE NOT NULL,
    PasswordHash VARCHAR(255) NOT NULL,
    RoleName VARCHAR(20) NOT NULL,
    Status VARCHAR(20) DEFAULT 'ACTIVE'
);
GO

-- ============================================
-- TABELA FILMY
-- ============================================

CREATE TABLE Movies (
    MovieID INT PRIMARY KEY IDENTITY(1,1),
    Title VARCHAR(100) NOT NULL,
    Description TEXT,
    Genre VARCHAR(50),
    Director VARCHAR(100),
    DurationMinutes INT,
    PosterURL VARCHAR(255)
);
GO

-- ============================================
-- TABELA SALE
-- ============================================

CREATE TABLE Rooms (
    RoomID INT PRIMARY KEY IDENTITY(1,1),
    RoomNumber INT NOT NULL,
    Capacity INT NOT NULL,
    RoomType VARCHAR(20)
);
GO

-- ============================================
-- TABELA MIEJSCA
-- ============================================

CREATE TABLE Seats (
    SeatID INT PRIMARY KEY IDENTITY(1,1),
    RoomID INT NOT NULL,
    RowNumber CHAR(1),
    SeatNumber INT,
    SeatType VARCHAR(20),

    FOREIGN KEY (RoomID)
    REFERENCES Rooms(RoomID)
);
GO

-- ============================================
-- TABELA SEANSE
-- ============================================

CREATE TABLE Screenings (
    ScreeningID INT PRIMARY KEY IDENTITY(1,1),
    MovieID INT NOT NULL,
    RoomID INT NOT NULL,
    ScreeningDate DATE,
    StartTime TIME,
    AvailableSeats INT,

    FOREIGN KEY (MovieID)
    REFERENCES Movies(MovieID),

    FOREIGN KEY (RoomID)
    REFERENCES Rooms(RoomID)
);
GO

-- ============================================
-- TABELA REZERWACJE
-- ============================================

CREATE TABLE Reservations (
    ReservationID INT PRIMARY KEY IDENTITY(1,1),
    UserID INT NOT NULL,
    ScreeningID INT NOT NULL,
    ReservationDate DATETIME DEFAULT GETDATE(),
    Status VARCHAR(20),
    TotalPrice DECIMAL(10,2),

    FOREIGN KEY (UserID)
    REFERENCES Users(UserID),

    FOREIGN KEY (ScreeningID)
    REFERENCES Screenings(ScreeningID)
);
GO

-- ============================================
-- TABELA BILETY
-- ============================================

CREATE TABLE Tickets (
    TicketID INT PRIMARY KEY IDENTITY(1,1),
    ReservationID INT NOT NULL,
    SeatID INT NOT NULL,
    TicketType VARCHAR(20),
    Price DECIMAL(10,2),
    QRCode VARCHAR(255),

    FOREIGN KEY (ReservationID)
    REFERENCES Reservations(ReservationID),

    FOREIGN KEY (SeatID)
    REFERENCES Seats(SeatID)
);
GO

-- ============================================
-- TABELA PLATNOSCI
-- ============================================

CREATE TABLE Payments (
    PaymentID INT PRIMARY KEY IDENTITY(1,1),
    ReservationID INT NOT NULL,
    PaymentMethod VARCHAR(20),
    PaymentStatus VARCHAR(20),
    Amount DECIMAL(10,2),
    PaymentDate DATETIME DEFAULT GETDATE(),

    FOREIGN KEY (ReservationID)
    REFERENCES Reservations(ReservationID)
);
GO
-- ============================================
-- TABELA ADMINS
-- ============================================

CREATE TABLE Admins (
    AdminID INT PRIMARY KEY IDENTITY(1,1),
    UserID INT NOT NULL UNIQUE,
    PermissionLevel VARCHAR(50),
    CreatedAt DATETIME DEFAULT GETDATE(),

    FOREIGN KEY (UserID)
    REFERENCES Users(UserID)
);
GO
